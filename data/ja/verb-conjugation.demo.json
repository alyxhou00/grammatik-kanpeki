      "prompt": {
        "verb": "{起|お}きる",
        "meaning": "起床",
        "formLabel": "た形（過去）",
        "sentence": "{今朝|けさ}は{六時|ろくじ}に___。",
        "translation": { "zh-Hant": "今天早上六點起床了。" }
      },
      "answer": {
        "accepted": ["{起|お}きた"],
        "acceptable": [
          { "text": "{起|お}きました", "note": "文法正確，但這題要普通形（常體）。" }
        ],
        "mistakes": [
          { "text": "{起|お}きった", "note": "一段動詞沒有音便：直接去掉「る」＋た。" }
        ]
      },
      "explanation": { "zh-Hant": "起きる是上一段動詞，去掉「る」＋た → 起きた。一段動詞沒有任何音便。" }
    },
    {
      "id": "ja-vc-demo-010",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
