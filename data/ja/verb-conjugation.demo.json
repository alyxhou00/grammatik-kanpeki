      },
      "prompt": {
        "base": { "word": "{見|み}る", "meaning": "看", "pos": "動詞" },
        "task": "たい形（想做）",
        "sentence": "{週末|しゅうまつ}、{新|あたら}しい{映画|えいが}を___。",
        "translation": {
          "zh-Hant": "週末想看新的電影。"
        },
        "words": [
          {
            "text": "{週末|しゅうまつ}",
            "meaning": "週末",
            "pos": "名詞"
          },
          {
            "text": "{新|あたら}しい",
            "meaning": "新的",
            "pos": "い形容詞"
          },
          {
            "text": "{映画|えいが}",
            "meaning": "電影",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{見|み}たい"
        ],
        "acceptable": [
          {
            "text": "{見|み}たいです",
            "note": "正確而且更禮貌；這題用普通形就好。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "見る是上一段動詞（る前面是い段音），去掉「る」＋たい → 見たい。「たい」是い形容詞，表示「想做…」。"
      }
    },
    {
      "id": "ja-vc-demo-007",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
