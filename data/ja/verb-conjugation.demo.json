  "cards": [
    {
      "id": "ja-vc-demo-001",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "一段",
        "ない形"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "shimo-ichidan",
        "form": "nai"
      },
      "prompt": {
        "base": { "word": "{食|た}べる", "meaning": "吃", "pos": "動詞" },
        "task": "ない形（否定）",
        "sentence": "{朝|あさ}ごはんはあまり___。",
        "translation": {
          "zh-Hant": "我不太吃早餐。"
        },
        "words": [
          {
            "text": "{朝|あさ}ごはん",
            "meaning": "早餐",
            "pos": "名詞"
          },
          {
            "text": "あまり",
            "meaning": "不太…（後接否定）",
            "pos": "副詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{食|た}べない"
        ],
        "acceptable": [
          {
            "text": "{食|た}べません",
            "note": "文法正確，但這題要普通形（常體）。"
          }
        ],
        "mistakes": [
          {
            "text": "{食|た}べらない",
            "note": "一段動詞不用加「ら」：直接去掉「る」＋ない。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "食べる是下一段動詞（る前面是え段音）。一段動詞只要去掉「る」＋ない → 食べない。"
      }
    },
    {
      "id": "ja-vc-demo-002",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "五段",
        "て形",
        "撥音便"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "te"
      },
      "prompt": {
        "base": { "word": "{飲|の}む", "meaning": "喝；吃（藥）", "pos": "動詞" },
        "task": "て形 ＋ ください",
        "sentence": "{薬|くすり}を___ください。",
        "translation": {
          "zh-Hant": "請吃藥。"
        },
        "words": [
          {
            "text": "{薬|くすり}",
            "meaning": "藥",
            "pos": "名詞"
          },
          {
            "text": "ください",
            "meaning": "請…（接在て形後面）",
            "pos": "補助動詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{飲|の}んで"
        ],
        "mistakes": [
          {
            "text": "{飲|の}みて",
            "note": "五段動詞「む」結尾接て要撥音便：む → んで。"
          },
          {
            "text": "{飲|の}んて",
            "note": "撥音便後面要濁音化：んで，不是んて。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "飲む是五段動詞，「む」結尾接て要撥音便：む → んで → 飲んで＋ください。日文的「吃藥」說「薬を飲む」。"
      }
    },
    {
      "id": "ja-vc-demo-003",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "五段",
        "た形",
        "例外"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "ta"
      },
      "prompt": {
        "base": { "word": "{行|い}く", "meaning": "去", "pos": "動詞" },
        "task": "た形（過去）",
        "sentence": "{昨日|きのう}、{友達|ともだち}と{映画館|えいがかん}に___。",
        "translation": {
          "zh-Hant": "昨天和朋友去了電影院。"
        },
        "words": [
          {
            "text": "{昨日|きのう}",
            "meaning": "昨天",
            "pos": "名詞"
          },
          {
            "text": "{友達|ともだち}",
            "meaning": "朋友",
            "pos": "名詞"
          },
          {
            "text": "{映画館|えいがかん}",
            "meaning": "電影院",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{行|い}った"
        ],
        "acceptable": [
          {
            "text": "{行|い}きました",
            "note": "文法正確，但這題要普通形（常體）。"
          }
        ],
        "mistakes": [
          {
            "text": "{行|い}いた",
            "note": "「行く」是例外：用促音便變成「行った」，不是「行いた」。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「く」結尾的五段動詞本來用イ音便（書く → 書いた），只有「行く」是例外，用促音便 → 行った。"
      }
    },
    {
      "id": "ja-vc-demo-004",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "不規則",
        "ます形"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "irregular",
        "form": "masu"
      },
      "prompt": {
        "base": { "word": "{来|く}る", "meaning": "來", "pos": "動詞" },
        "task": "ます形（禮貌）",
        "sentence": "{明日|あした}、{先生|せんせい}が{学校|がっこう}に___。",
        "translation": {
          "zh-Hant": "明天老師會來學校。"
        },
        "words": [
          {
            "text": "{明日|あした}",
            "meaning": "明天",
            "pos": "名詞"
          },
          {
            "text": "{先生|せんせい}",
            "meaning": "老師",
            "pos": "名詞"
          },
          {
            "text": "{学校|がっこう}",
            "meaning": "學校",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{来|き}ます"
        ],
        "acceptable": [
          {
            "text": "{来|く}る",
            "note": "文法正確，但這題要禮貌形（ます形）。"
          }
        ],
        "mistakes": [
          {
            "text": "くります",
            "note": "「来る」是不規則動詞：ます形讀作「きます」。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "来る是不規則動詞，ます形的讀音會變：来る（くる）→ 来ます（きます）。"
      }
    },
    {
      "id": "ja-vc-demo-005",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "不規則",
        "ている形"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "irregular",
        "form": "teiru"
      },
      "prompt": {
        "base": { "word": "する", "meaning": "做", "pos": "動詞" },
        "task": "ている形（正在）",
        "sentence": "{弟|おとうと}は{今|いま}、{宿題|しゅくだい}を___。",
        "translation": {
          "zh-Hant": "弟弟現在正在寫作業。"
        },
        "words": [
          {
            "text": "{弟|おとうと}",
            "meaning": "（我的）弟弟",
            "pos": "名詞"
          },
          {
            "text": "{今|いま}",
            "meaning": "現在",
            "pos": "名詞"
          },
          {
            "text": "{宿題|しゅくだい}",
            "meaning": "作業；功課",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "している"
        ],
        "acceptable": [
          {
            "text": "しています",
            "note": "文法正確，但這題要普通形（常體）。"
          },
          {
            "text": "してる",
            "note": "口語縮約，日常會話可以，書面請用「している」。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "する是不規則動詞，て形是「して」，＋いる 表示動作正在進行 → している。"
      }
    },
    {
      "id": "ja-vc-demo-006",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": [
        "一段",
        "たい形"
