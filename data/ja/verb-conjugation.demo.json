      "prompt": {
        "base": { "word": "{書|か}く", "meaning": "寫", "pos": "動詞" },
        "task": "ました形（禮貌・過去）",
        "sentence": "{昨日|きのう}、{母|はは}に{手紙|てがみ}を___。",
        "translation": {
          "zh-Hant": "昨天寫了一封信給媽媽。"
        },
        "words": [
          {
            "text": "{昨日|きのう}",
            "meaning": "昨天",
            "pos": "名詞"
          },
          {
            "text": "{母|はは}",
            "meaning": "（我的）媽媽",
            "pos": "名詞"
          },
          {
            "text": "{手紙|てがみ}",
            "meaning": "信",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{書|か}きました"
        ],
        "acceptable": [
          {
            "text": "{書|か}いた",
            "note": "文法正確，但這題要禮貌形（ました）。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "書く是五段動詞，ます形用い段：く → き＋ます；過去式是「ました」→ 書きました。"
      }
    },
    {
      "id": "ja-vc-demo-008",
