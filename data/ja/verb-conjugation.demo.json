      "createdAt": "2026-11-03",
      "meta": { "verbClass": "godan", "form": "nakatta" },
      "prompt": {
        "verb": "{買|か}う",
        "meaning": "買",
        "formLabel": "なかった形（過去否定）",
        "sentence": "{昨日|きのう}は{何|なに}も___。",
        "translation": { "zh-Hant": "昨天什麼都沒買。" }
      },
      "answer": {
        "accepted": ["{買|か}わなかった"],
        "acceptable": [
          { "text": "{買|か}いませんでした", "note": "文法正確，但這題要普通形（常體）。" }
        ],
        "mistakes": [
          { "text": "{買|か}あなかった", "note": "「う」結尾的五段動詞，否定要用「わ」，不是「あ」。" }
        ]
      },
      "explanation": { "zh-Hant": "買う是五段動詞。「う」結尾的否定形用「わ」：買う → 買わない → 過去否定「買わなかった」。" }
    },
    {
      "id": "ja-vc-demo-012",
