  "cards": [
    {
      "id": "ja-vc-demo-001",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["一段", "ない形"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "shimo-ichidan", "form": "nai" },
      "prompt": {
        "verb": "{食|た}べる",
        "meaning": "吃",
        "formLabel": "ない形（否定）",
        "sentence": "{朝|あさ}ごはんはあまり___。",
        "translation": { "zh-Hant": "我不太吃早餐。" }
      },
      "answer": {
        "accepted": ["{食|た}べない"],
        "acceptable": [
          { "text": "{食|た}べません", "note": "文法正確，但這題要普通形（常體）。" }
        ],
        "mistakes": [
          { "text": "{食|た}べらない", "note": "一段動詞不用加「ら」：直接去掉「る」＋ない。" }
        ]
      },
      "explanation": { "zh-Hant": "食べる是下一段動詞（る前面是え段音）。一段動詞只要去掉「る」＋ない → 食べない。" }
    },
    {
      "id": "ja-vc-demo-002",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["五段", "て形", "撥音便"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "godan", "form": "te" },
      "prompt": {
        "verb": "{飲|の}む",
        "meaning": "喝；吃（藥）",
        "formLabel": "て形 ＋ ください",
        "sentence": "{薬|くすり}を___ください。",
        "translation": { "zh-Hant": "請吃藥。" }
      },
      "answer": {
        "accepted": ["{飲|の}んで"],
        "mistakes": [
          { "text": "{飲|の}みて", "note": "五段動詞「む」結尾接て要撥音便：む → んで。" },
          { "text": "{飲|の}んて", "note": "撥音便後面要濁音化：んで，不是んて。" }
        ]
      },
      "explanation": { "zh-Hant": "飲む是五段動詞，「む」結尾接て要撥音便：む → んで → 飲んで＋ください。日文的「吃藥」說「薬を飲む」。" }
    },
    {
      "id": "ja-vc-demo-003",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["五段", "た形", "例外"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "godan", "form": "ta" },
      "prompt": {
        "verb": "{行|い}く",
        "meaning": "去",
        "formLabel": "た形（過去）",
        "sentence": "{昨日|きのう}、{友達|ともだち}と{映画館|えいがかん}に___。",
        "translation": { "zh-Hant": "昨天和朋友去了電影院。" }
      },
      "answer": {
        "accepted": ["{行|い}った"],
        "acceptable": [
          { "text": "{行|い}きました", "note": "文法正確，但這題要普通形（常體）。" }
        ],
        "mistakes": [
          { "text": "{行|い}いた", "note": "「行く」是例外：用促音便變成「行った」，不是「行いた」。" }
        ]
      },
      "explanation": { "zh-Hant": "「く」結尾的五段動詞本來用イ音便（書く → 書いた），只有「行く」是例外，用促音便 → 行った。" }
    },
    {
      "id": "ja-vc-demo-004",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["不規則", "ます形"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "irregular", "form": "masu" },
      "prompt": {
        "verb": "{来|く}る",
        "meaning": "來",
        "formLabel": "ます形（禮貌）",
        "sentence": "{明日|あした}、{先生|せんせい}が{学校|がっこう}に___。",
        "translation": { "zh-Hant": "明天老師會來學校。" }
      },
      "answer": {
        "accepted": ["{来|き}ます"],
        "acceptable": [
          { "text": "{来|く}る", "note": "文法正確，但這題要禮貌形（ます形）。" }
        ],
        "mistakes": [
          { "text": "くります", "note": "「来る」是不規則動詞：ます形讀作「きます」。" }
        ]
      },
      "explanation": { "zh-Hant": "来る是不規則動詞，ます形的讀音會變：来る（くる）→ 来ます（きます）。" }
    },
    {
      "id": "ja-vc-demo-005",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["不規則", "ている形"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "irregular", "form": "teiru" },
      "prompt": {
        "verb": "する",
        "meaning": "做",
        "formLabel": "ている形（正在）",
        "sentence": "{弟|おとうと}は{今|いま}、{宿題|しゅくだい}を___。",
        "translation": { "zh-Hant": "弟弟現在正在寫作業。" }
      },
      "answer": {
        "accepted": ["している"],
        "acceptable": [
          { "text": "しています", "note": "文法正確，但這題要普通形（常體）。" },
          { "text": "してる", "note": "口語縮約，日常會話可以，書面請用「している」。" }
        ]
      },
      "explanation": { "zh-Hant": "する是不規則動詞，て形是「して」，＋いる 表示動作正在進行 → している。" }
    },
    {
      "id": "ja-vc-demo-006",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["一段", "たい形"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "kami-ichidan", "form": "tai" },
      "prompt": {
        "verb": "{見|み}る",
        "meaning": "看",
        "formLabel": "たい形（想做）",
        "sentence": "{週末|しゅうまつ}、{新|あたら}しい{映画|えいが}を___。",
        "translation": { "zh-Hant": "週末想看新的電影。" }
      },
      "answer": {
        "accepted": ["{見|み}たい"],
        "acceptable": [
          { "text": "{見|み}たいです", "note": "正確而且更禮貌；這題用普通形就好。" }
        ]
      },
      "explanation": { "zh-Hant": "見る是上一段動詞（る前面是い段音），去掉「る」＋たい → 見たい。「たい」是い形容詞，表示「想做…」。" }
    },
    {
      "id": "ja-vc-demo-007",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["五段", "ました形"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "godan", "form": "mashita" },
      "prompt": {
        "verb": "{書|か}く",
        "meaning": "寫",
        "formLabel": "ました形（禮貌・過去）",
        "sentence": "{昨日|きのう}、{母|はは}に{手紙|てがみ}を___。",
        "translation": { "zh-Hant": "昨天寫了一封信給媽媽。" }
      },
      "answer": {
        "accepted": ["{書|か}きました"],
        "acceptable": [
          { "text": "{書|か}いた", "note": "文法正確，但這題要禮貌形（ました）。" }
        ]
      },
      "explanation": { "zh-Hant": "書く是五段動詞，ます形用い段：く → き＋ます；過去式是「ました」→ 書きました。" }
    },
    {
      "id": "ja-vc-demo-008",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["五段", "ない形", "陷阱"],
      "createdAt": "2026-11-03",
      "meta": { "verbClass": "godan", "form": "nai" },
      "prompt": {
        "verb": "{帰|かえ}る",
        "meaning": "回去；回家",
        "formLabel": "ない形（否定）",
        "sentence": "{今日|きょう}は{家|いえ}に___。",
        "translation": { "zh-Hant": "今天不回家。" }
      },
      "answer": {
        "accepted": ["{帰|かえ}らない"],
        "acceptable": [
          { "text": "{帰|かえ}りません", "note": "文法正確，但這題要普通形（常體）。" }
        ],
        "mistakes": [
          { "text": "{帰|かえ}ない", "note": "「帰る」看起來像一段動詞，其實是五段：る → ら＋ない。" }
        ]
      },
      "explanation": { "zh-Hant": "帰る是偽裝成一段的五段動詞（同類：走る、入る、知る、切る）。否定形把「る」改成あ段「ら」＋ない → 帰らない。" }
    },
    {
      "id": "ja-vc-demo-009",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo",
      "level": "N5",
      "tags": ["一段", "た形"],
      "createdAt": "2026-11-03",
