      "prompt": {
        "base": { "word": "{帰|かえ}る", "meaning": "回去；回家", "pos": "動詞" },
        "task": "ない形（否定）",
        "sentence": "{今日|きょう}は{家|いえ}に___。",
        "translation": {
          "zh-Hant": "今天不回家。"
        },
        "words": [
          {
            "text": "{今日|きょう}",
            "meaning": "今天",
            "pos": "名詞"
          },
          {
            "text": "{家|いえ}",
            "meaning": "家",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{帰|かえ}らない"
        ],
        "acceptable": [
          {
            "text": "{帰|かえ}りません",
            "note": "文法正確，但這題要普通形（常體）。"
          }
        ],
        "mistakes": [
          {
            "text": "{帰|かえ}ない",
            "note": "「帰る」看起來像一段動詞，其實是五段：る → ら＋ない。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "帰る是偽裝成一段的五段動詞（同類：走る、入る、知る、切る）。否定形把「る」改成あ段「ら」＋ない → 帰らない。"
      }
