        "formLabel": "て形 ＋ ください",
        "sentence": "ちょっと___ください。",
        "translation": { "zh-Hant": "請稍等一下。" }
      },
      "answer": {
        "accepted": ["{待|ま}って"],
        "mistakes": [
          { "text": "{待|ま}ちて", "note": "「つ」結尾接て要促音便：つ → って。" }
        ]
      },
      "explanation": { "zh-Hant": "待つ是五段動詞，「つ」結尾接て要促音便：つ → って → 待って＋ください。" }
    },
    {
      "id": "ja-vc-demo-011",
