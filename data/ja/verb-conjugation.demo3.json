            "meaning": "念書；學習",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "します"
        ],
        "acceptable": [
          {
            "text": "する",
            "note": "文法正確，但這題要禮貌形（ます形）。"
          }
        ],
        "mistakes": [
