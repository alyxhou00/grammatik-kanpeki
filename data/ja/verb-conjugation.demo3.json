      },
      "prompt": {
        "base": {
          "word": "{食|た}べる",
          "meaning": "吃",
          "pos": "動詞"
        },
        "task": "ます形",
        "register": "polite",
        "sentence": "{毎朝|まいあさ}、パンを___。",
        "translation": {
          "zh-Hant": "每天早上吃麵包。"
        },
        "words": [
          {
            "text": "{毎朝|まいあさ}",
            "meaning": "每天早上",
            "pos": "名詞"
          },
          {
            "text": "パン",
            "meaning": "麵包",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{食|た}べます"
        ],
        "acceptable": [
          {
            "text": "{食|た}べる",
            "note": "文法正確，但這題要禮貌形（ます形）。"
          }
        ],
        "mistakes": [
          {
            "text": "{食|た}べります",
            "note": "一段動詞直接去掉「る」再加「ます」，不會變成「り」。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "食べる是一段動詞（第二類）：去掉「る」＋ます → 食べます。一段動詞的變化最簡單，所有形都是「去る＋語尾」。"
      }
    },
