      },
      "prompt": {
        "base": { "word": "{撮|と}る", "meaning": "拍（照）", "pos": "動詞" },
        "task": "てはいけない（不可以…）",
        "sentence": "ここで{写真|しゃしん}を___はいけません。",
        "translation": {
          "zh-Hant": "這裡不可以拍照。"
        },
        "words": [
          {
            "text": "ここ",
            "meaning": "這裡",
            "pos": "代名詞"
          },
          {
            "text": "{写真|しゃしん}",
            "meaning": "照片",
            "pos": "名詞"
          },
          {
            "text": "いけません",
            "lemma": "いけない",
            "meaning": "不行；不可以",
            "pos": "片語"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{撮|と}って"
        ],
        "mistakes": [
          {
            "text": "{撮|と}りて",
            "note": "「る」結尾的五段動詞接て要促音便：る → って。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "撮る是五段動詞，「る」結尾接て要促音便：撮って＋はいけません，表示禁止。"
      }
    },
    {
      "id": "ja-vc-demo2-007",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "五段",
        "たことがある"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "ta-koto-ga-aru"
      },
      "prompt": {
        "base": { "word": "{乗|の}る", "meaning": "搭乘", "pos": "動詞" },
        "task": "たことがある（曾經…過）",
        "sentence": "{新幹線|しんかんせん}に___ことがありますか。",
        "translation": {
          "zh-Hant": "你搭過新幹線嗎？"
        },
        "words": [
          {
            "text": "{新幹線|しんかんせん}",
            "meaning": "新幹線（日本高鐵）",
            "pos": "名詞"
          },
          {
            "text": "こと",
            "meaning": "事情",
            "pos": "名詞"
          },
          {
            "text": "あります",
            "lemma": "ある",
            "meaning": "有；在（物品）",
            "pos": "動詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{乗|の}った"
        ],
        "mistakes": [
          {
            "text": "{乗|の}りた",
            "note": "五段動詞接た要音便：る → った → 乗った。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「たことがある」接在た形後面，表示經驗。乗る是五段動詞：る → った → 乗った。搭乘交通工具用助詞「に」：新幹線に乗る。"
      }
    },
