  "cards": [
    {
      "id": "ja-vc-demo2-001",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "不規則",
        "ませんでした形"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "irregular",
        "form": "masendeshita"
      },
      "prompt": {
        "base": { "word": "{勉強|べんきょう}する", "meaning": "念書；學習", "pos": "動詞" },
        "task": "ませんでした形（過去否定）",
        "register": "polite",
        "sentence": "{昨日|きのう}は{全然|ぜんぜん}___。",
        "translation": {
          "zh-Hant": "昨天完全沒有念書。"
        },
        "words": [
          {
            "text": "{昨日|きのう}",
            "meaning": "昨天",
            "pos": "名詞"
          },
          {
            "text": "{全然|ぜんぜん}",
            "meaning": "完全（不）…（後接否定）",
            "pos": "副詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{勉強|べんきょう}しませんでした"
        ],
        "acceptable": [
          {
            "text": "{勉強|べんきょう}しなかった",
            "note": "文法正確，但這題要禮貌形（ませんでした）。"
          }
        ],
        "mistakes": [
          {
            "text": "{勉強|べんきょう}しないでした",
            "note": "「ない」不能直接接「でした」。禮貌的過去否定是「ませんでした」。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「勉強する」是「名詞＋する」的不規則動詞，只要變化「する」：します → しません → しませんでした。"
      }
    },
    {
      "id": "ja-vc-demo2-002",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "五段",
        "ながら"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "nagara"
      },
      "prompt": {
        "base": { "word": "{聞|き}く", "meaning": "聽；問", "pos": "動詞" },
        "task": "ながら（一邊…一邊…）",
        "sentence": "{音楽|おんがく}を___、{駅|えき}まで{歩|ある}いた。",
        "translation": {
          "zh-Hant": "一邊聽音樂，一邊走到車站。"
        },
        "words": [
          {
            "text": "{音楽|おんがく}",
            "meaning": "音樂",
            "pos": "名詞"
          },
          {
            "text": "{駅|えき}",
            "meaning": "車站",
            "pos": "名詞"
          },
          {
            "text": "まで",
            "meaning": "到…為止",
            "pos": "助詞"
          },
          {
            "text": "{歩|ある}いた",
            "lemma": "{歩|ある}く",
            "meaning": "走路",
            "pos": "動詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{聞|き}きながら"
        ],
        "mistakes": [
          {
            "text": "{聞|き}くながら",
            "note": "「ながら」要接連用形（ます形去掉ます）：聞きます → 聞きながら。"
          },
          {
            "text": "{聞|き}いてながら",
            "note": "「ながら」要接連用形（ます形去掉ます）：聞きます → 聞きながら。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「ながら」接在連用形（ます形去掉ます）後面：聞きます → 聞き＋ながら，表示同時做兩件事。"
      }
    },
    {
      "id": "ja-vc-demo2-003",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "五段",
        "～に行く"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "ni-iku"
      },
      "prompt": {
        "base": { "word": "{買|か}う", "meaning": "買", "pos": "動詞" },
        "task": "～に行く（去做…）",
        "sentence": "スーパーへ{牛乳|ぎゅうにゅう}を___に{行|い}きます。",
        "translation": {
          "zh-Hant": "我要去超市買牛奶。"
        },
        "words": [
          {
            "text": "スーパー",
            "meaning": "超市",
            "pos": "名詞"
          },
          {
            "text": "{牛乳|ぎゅうにゅう}",
            "meaning": "牛奶",
            "pos": "名詞"
          },
          {
            "text": "{行|い}きます",
            "lemma": "{行|い}く",
            "meaning": "去",
            "pos": "動詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{買|か}い"
        ],
        "mistakes": [
          {
            "text": "{買|か}う",
            "note": "「～に行く」前面要用連用形（ます形去掉ます）：買います → 買いに行く。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「～に行く」表示去某處的目的，前面接連用形：買います → 買い＋に行く。"
      }
    },
    {
      "id": "ja-vc-demo2-004",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "五段",
        "てから"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "godan",
        "form": "tekara"
      },
      "prompt": {
        "base": { "word": "{洗|あら}う", "meaning": "洗", "pos": "動詞" },
        "task": "てから（做完…之後再…）",
        "sentence": "{手|て}を___から、ご{飯|はん}を{食|た}べます。",
        "translation": {
          "zh-Hant": "先洗手，再吃飯。"
        },
        "words": [
          {
            "text": "{手|て}",
            "meaning": "手",
            "pos": "名詞"
          },
          {
            "text": "ご{飯|はん}",
            "meaning": "飯；餐",
            "pos": "名詞"
          },
          {
            "text": "{食|た}べます",
            "lemma": "{食|た}べる",
            "meaning": "吃",
            "pos": "動詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{洗|あら}って"
        ],
        "mistakes": [
          {
            "text": "{洗|あら}いて",
            "note": "「う」結尾接て要促音便：う → って。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "洗う是五段動詞，「う」結尾接て要促音便：う → って → 洗って＋から，表示「做完…之後再…」。"
      }
    },
    {
      "id": "ja-vc-demo2-005",
      "language": "ja",
      "topic": "verb-conjugation",
      "source": "demo2",
      "level": "N5",
      "tags": [
        "一段",
        "てもいい"
      ],
      "createdAt": "2026-11-03",
      "meta": {
        "verbClass": "shimo-ichidan",
        "form": "te-mo-ii"
      },
      "prompt": {
        "base": { "word": "{開|あ}ける", "meaning": "打開", "pos": "動詞" },
        "task": "てもいい（可以…嗎）",
        "sentence": "{窓|まど}を___もいいですか。",
        "translation": {
          "zh-Hant": "可以開窗戶嗎？"
        },
        "words": [
          {
            "text": "{窓|まど}",
            "meaning": "窗戶",
            "pos": "名詞"
          },
          {
            "text": "いい",
            "meaning": "好的；可以",
            "pos": "い形容詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{開|あ}けて"
        ],
        "mistakes": [
          {
            "text": "{開|あ}けって",
            "note": "一段動詞沒有音便：去掉「る」＋て。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "開ける是下一段動詞，去掉「る」＋て → 開けて＋もいいですか，用來詢問許可。"
      }
    },
    {
      "id": "ja-vc-demo2-006",
