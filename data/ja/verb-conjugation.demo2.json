      },
      "prompt": {
        "base": { "word": "{住|す}む", "meaning": "住", "pos": "動詞" },
        "task": "ています形（狀態）",
        "register": "polite",
        "sentence": "{姉|あね}は{東京|とうきょう}に___。",
        "translation": {
          "zh-Hant": "我姊姊住在東京。"
        },
        "words": [
          {
            "text": "{姉|あね}",
            "meaning": "（我的）姊姊",
            "pos": "名詞"
          },
          {
            "text": "{東京|とうきょう}",
            "meaning": "東京",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{住|す}んでいます"
        ],
        "acceptable": [
          {
            "text": "{住|す}んでいる",
            "note": "文法正確，但這題要禮貌形（ています）。"
          }
        ],
        "mistakes": [
          {
            "text": "{住|す}みます",
            "note": "「住在某地」是持續的狀態，要用「ている」：住んでいます。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "「ている」不只表示正在進行，也表示持續的狀態。「住在…」要說「住んでいる」：む → んで＋います。"
      }
    },
    {
      "id": "ja-vc-demo2-011",
      "language": "ja",
