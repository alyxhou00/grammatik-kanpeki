        "base": { "word": "{知|し}る", "meaning": "知道；認識", "pos": "動詞" },
        "task": "ています形（狀態）",
        "register": "polite",
        "sentence": "あの{人|ひと}の{名前|なまえ}を___か。",
        "translation": {
          "zh-Hant": "你知道那個人的名字嗎？"
        },
        "words": [
          {
            "text": "あの",
            "meaning": "那個（遠稱）",
            "pos": "連體詞"
          },
          {
            "text": "{人|ひと}",
            "meaning": "人",
            "pos": "名詞"
          },
          {
            "text": "{名前|なまえ}",
            "meaning": "名字",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{知|し}っています"
        ],
        "mistakes": [
          {
            "text": "{知|し}ります",
            "note": "「知道」要用「知っている」表示狀態，「知ります」幾乎不用。"
          },
          {
            "text": "{知|し}ています",
            "note": "知る是偽裝成一段的五段動詞，て形要促音便：知って。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "知る看起來像一段動詞，其實是五段：る → って → 知っています。「知道」要用ている形；否定則是「知りません」。"
      }
    },
    {
