        "sentence": "{今日|きょう}は{家|いえ}で___ほうがいいですよ。",
        "translation": {
          "zh-Hant": "今天最好在家休息喔。"
        },
        "words": [
          {
            "text": "{今日|きょう}",
            "meaning": "今天",
            "pos": "名詞"
          },
          {
            "text": "{家|いえ}",
            "meaning": "家",
            "pos": "名詞"
          },
          {
            "text": "ほう",
            "meaning": "方面（ほうがいい＝最好…）",
            "pos": "名詞"
          },
          {
            "text": "いい",
            "meaning": "好的；可以",
            "pos": "い形容詞"
          }
        ]
      },
      "answer": {
