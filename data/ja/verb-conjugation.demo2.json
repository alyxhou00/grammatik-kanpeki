      "prompt": {
        "base": { "word": "{入|はい}る", "meaning": "進入；（お風呂に入る）泡澡", "pos": "動詞" },
        "task": "ない形（否定）",
        "register": "plain",
        "sentence": "{今日|きょう}はお{風呂|ふろ}に___。",
        "translation": {
          "zh-Hant": "今天不泡澡。"
        },
        "words": [
          {
            "text": "{今日|きょう}",
            "meaning": "今天",
            "pos": "名詞"
          },
          {
            "text": "お{風呂|ふろ}",
            "meaning": "浴缸；洗澡",
            "pos": "名詞"
          }
        ]
      },
      "answer": {
        "accepted": [
          "{入|はい}らない"
        ],
        "acceptable": [
          {
            "text": "{入|はい}りません",
            "note": "文法正確，但這題要普通形（常體）。"
          }
        ],
        "mistakes": [
          {
            "text": "{入|はい}ない",
            "note": "入る是偽裝成一段的五段動詞：る → ら＋ない。"
          }
        ]
      },
      "explanation": {
        "zh-Hant": "入る是偽裝成一段的五段動詞（跟帰る、走る、知る同類）：入らない。「お風呂に入る」是泡澡、洗澡的意思。"
      }
    },
